# ============================================================================
# 本仓库只提交 project/ —— 代码、配置、报告，全是纯文本，约 864 KB。
#
# 其余目录一律排除，合计约 7.8 GB：
#   data/    3.9 GB   158,654 张 jpg + 158,654 个 xml，可由 raw/ 的 zip 解压得到
#   raw/     2.9 GB   数据集 zip（含 sha256 校验），从 Kaggle 重新下载即可
#   .venv/   1.0 GB   虚拟环境，按 project/environment/ 重建
#   runs/     54 MB   全部产物（parquet / COCO json / 预测 / 指标），可完全重建
#
# runs/ 虽然只有 54 MB，仍然不提交 —— 它是派生数据，
# 且每个阶段的 report/*.md 里已经记录了全部实测数字。
# 复现方式见 project/README.md 各阶段的「复现本阶段」小节。
# ============================================================================

# ---- 数据与产物（体积大且可重建）------------------------------------------
/data/
/raw/
# runs/ 整体不进仓库，只放行分析时需要、且已经冻结不再变动的几份（约 45 MB）：
# baseline 的三份预测与 manifest、标注表、数据划分、三份 COCO GT
/runs/*
!/runs/predictions/
/runs/predictions/*
!/runs/predictions/L1_rpn_proposals.parquet
!/runs/predictions/L2_owlv2_zeroshot.parquet
!/runs/predictions/L3_coco_collapsed.parquet
!/runs/predictions/manifest_*.json
!/runs/tables/
/runs/tables/*
!/runs/tables/annotations.parquet
!/runs/tables/images.parquet
!/runs/tables/classes.parquet
!/runs/splits/
!/runs/eval/
/runs/eval/*
!/runs/eval/gt/

# ---- 虚拟环境 --------------------------------------------------------------
/.venv/
venv/
env/

# ---- Python 缓存 -----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/

# ---- Jupyter ---------------------------------------------------------------
.ipynb_checkpoints/

# ---- 数据/模型文件（防止误提交到任何位置）----------------------------------
*.parquet
*.zip
*.pth
*.pt
*.onnx
*.safetensors
*.jpg
*.jpeg
*.png
*.xml

# ---- macOS / 编辑器 --------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
*~

# ---- 集群用户手册标注为 Restricted，不进仓库 ------------------------------------
project/CCDSGPU-TC2-Masters-UserGuide.pdf

# 上面放行的 runs/ 文件里有 parquet，不能被 *.parquet 挡住
!/runs/**/*.parquet
/runs/tables/file_inventory.parquet
